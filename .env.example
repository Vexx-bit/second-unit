# Copy to .env and fill in. NEVER commit the real .env.

# --- Grafana Cloud ---------------------------------------------------------
# Your stack URL, e.g. https://samuelkangethe.grafana.net
GRAFANA_URL=
# Service-account token (starts with glsa_). Grafana Cloud > Administration >
# Users and access > Service accounts. Shown once — store in Secret Manager.
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# --- Grafana Cloud OTLP (for telemetry-sim + AI Observability) -------------
# Connections > Add new connection > OpenTelemetry (OTLP) gives you these.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# --- Google Cloud ----------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# --- MCP -------------------------------------------------------------------
# Cloud Run URL of your self-hosted mcp-grafana, e.g.
# https://grafana-mcp-xxxxx-uc.a.run.app/mcp
GRAFANA_MCP_URL=
